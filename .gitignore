# FaceIDKit — Aviorrok's proprietary framework, licensed for this app only and
# explicitly not for any repository. Kept out of git entirely rather than
# out of the public repo, because history is forever and this one is intended
# to be opened up.
Frameworks/


# Training data. A gigabyte of labelled spoof images, and git history is forever —
# the model built from it (Resources/Spoof.mlmodel) is what the app actually needs.
Face Spoof Detection.v1i.createml/
dataset-subset/

# Local datasets; only the directory guide belongs in source control.
/Data/*
!/Data/README.md

# Per-session agent scratch, not project configuration.
.claude/

