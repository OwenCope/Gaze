<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Deliberately not sandboxed. The unlock backends need to talk to a
	  privileged helper (authorization plugin path) or post CGEvents to the
	  login window (keystroke path); neither survives the sandbox.
	-->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
