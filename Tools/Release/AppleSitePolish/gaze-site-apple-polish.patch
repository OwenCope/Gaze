+
+/* ---------- Public-page polish (additive) ----------
+   Everything below refines the marketing pages without touching the
+   tokens, components, or app surfaces above. */
+
+/* Smooth anchor travel. The reduced-motion guard above already forces
+   `scroll-behavior: auto !important`, so this never animates for users
+   who asked for less motion. */
+html {
+  scroll-behavior: smooth;
+}
+
+/* Every anchored section stops below the fixed 3.5rem nav, even where no
+   per-section utility class sets it. Same 5rem the sections already use. */
+section[id] {
+  scroll-margin-top: 5rem;
+}
+
+::selection {
+  background: color-mix(in srgb, var(--action-fill) 24%, transparent);
+}
+
+/* Skip link: parked off-screen until it receives keyboard focus, so mouse
+   and touch users never see it and keyboard users land on the content. */
+.skip-link {
+  position: fixed;
+  top: 0.75rem;
+  left: 0.75rem;
+  z-index: 100;
+  padding: 0.65rem 1rem;
+  border-radius: 999px;
+  background: var(--foreground);
+  color: var(--background);
+  font-size: 14px;
+  font-weight: 600;
+  text-decoration: none;
+  transform: translateY(-300%);
+  transition: transform 0.2s ease;
+}
+.skip-link:focus-visible {
+  transform: none;
+  outline: 2px solid var(--action);
+  outline-offset: 2px;
+}
+
+/* Translucency off: solid chrome, no blur. Legibility over material —
+   a blurred panel over page content helps nobody who asked for clarity. */
+@media (prefers-reduced-transparency: reduce) {
+  :root,
+  .dark {
+    --nav-bg: var(--background);
+    --dock-bg: var(--surface);
+    --panel-bg: var(--surface);
   }
+  .top-nav,
+  .switcher,
+  .panel {
+    backdrop-filter: none;
+    -webkit-backdrop-filter: none;
+  }
 }
+
+/* High contrast: a solid nav with a defined edge, and links that do not
+   rely on colour alone to read as links. */
+@media (prefers-contrast: more) {
+  :root,
+  .dark {
+    --nav-bg: var(--background);
+  }
+  .top-nav {
+    border-bottom-color: var(--foreground);
+  }
+  .site-link {
+    text-decoration: underline;
+  }
+}
