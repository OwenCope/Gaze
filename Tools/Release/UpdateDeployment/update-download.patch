+++ b/src/app/dl/[file]/route.ts
@@ -0,0 +1,26 @@
+import { NextResponse } from "next/server";
+import { getSettings } from "@/lib/settings";
+import { readAll } from "@/lib/store";
+import { releaseDownload, validDownloadName } from "@/lib/release-download";
+
+function missing() {
+  return NextResponse.json({ error: "Not found" }, { headers: { "Cache-Control": "no-store" }, status: 404 });
+}
+
+export async function GET(request: Request) {
+  const segment = /^\/dl\/([^/]+)$/.exec(new URL(request.url).pathname)?.[1];
+  if (!segment) return missing();
+  let file: string;
+  try { file = decodeURIComponent(segment); } catch { return missing(); }
+  if (!validDownloadName(file)) return missing();
+
+  const { releasesRequireSignIn } = await getSettings();
+  if (releasesRequireSignIn) return missing();
+  const matches = (await readAll()).filter((release) => !release.draft && !release.private && release.download?.name === file);
+  if (matches.length !== 1) return missing();
+  const download = releaseDownload(matches[0].download);
+  if (!download) return missing();
+
+  // The browser follows this temporary redirect; no artifact bytes pass through the function.
+  return NextResponse.redirect(download.url, { headers: { "Cache-Control": "no-store" }, status: 302 });
+}
