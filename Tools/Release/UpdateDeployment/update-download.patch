+++ b/src/lib/release-download.ts
@@ -0,0 +1,20 @@
+export type ReleaseDownload = { url: string; name: string; size: number };
+
+export function validDownloadName(name: string): boolean {
+  return name.length > 0 && name.length <= 255 && !/[\\/\u0000-\u001f\u007f]/.test(name)
+    && /\.(dmg|zip)$/i.test(name);
+}
+
+/** Only public Blob build URLs produced by the release uploader are advertised. */
+export function releaseDownload(download: ReleaseDownload | null | undefined): ReleaseDownload | null {
+  if (!download || typeof download.name !== "string" || !validDownloadName(download.name)
+    || typeof download.url !== "string" || download.url.length > 4096
+    || !Number.isSafeInteger(download.size) || download.size <= 0) return null;
+  let target: URL;
+  try { target = new URL(download.url); } catch { return null; }
+  if (target.protocol !== "https:" || target.username || target.password || target.port
+    || target.hash || target.search
+    || !/^[a-z0-9-]+\.public\.blob\.vercel-storage\.com$/.test(target.hostname)
+    || target.pathname === "/") return null;
+  return { url: target.href, name: download.name, size: download.size };
+}
