+ * resolves the name back to the stored URL on each request. A record with no
+ * usable filename offers no download rather than a fabricated one.
+ */
+function feedDownload(download: { url: string; name: string; size: number }) {
+  if (!download.name) {
+    return null;
+  }
+  return {
+    url: `https://gazeunlock.com/dl/${encodeURIComponent(download.name)}`,
+    name: download.name,
+    size: download.size,
+  };
+}
